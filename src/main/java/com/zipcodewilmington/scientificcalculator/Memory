package com.zipcodewilmington.scientificcalculator;
import java.util.Scanner;

public class Memory {
    private double storedValue;

    public Memory() {
        this.storedValue = 0.0;
    }

    public void store(double value) {
        this.storedValue = value;
    }

    public double recall() {
        return this.storedValue;
    }

    public void clear() {
        this.storedValue = 0.0;
    }

    public String getDisplay(displayMode mode) {
        switch (mode) {
            case BINARY:
                return Integer.toBinaryString((int) storedValue);
            case OCTAL:
                return Integer.toOctalString((int) storedValue);
            case HEXADECIMAL:
                return Integer.toHexString((int) storedValue);
            default:
                return Double.toString(storedValue);
        }
    }